# Adresse unique utilisée par le PC hôte, le second PC et le téléphone.
# À fixer avant le premier démarrage : elle devient le nom de serveur Matrix.
ORYMA_HOST=oryma.local

# Générer une valeur aléatoire différente pour chaque secret avant le premier démarrage.
# Ne jamais utiliser les valeurs d'exemple, ni committer le fichier .env créé.
POSTGRES_PASSWORD=replace-with-a-long-random-value
SYNAPSE_DB_PASSWORD=replace-with-a-long-random-value
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-value
ADMINAPI_DB_PASSWORD=replace-with-a-long-random-value
SYNAPSE_REGISTRATION_SECRET=replace-with-a-long-random-value
SYNAPSE_MACAROON_SECRET=replace-with-a-long-random-value
SYNAPSE_FORM_SECRET=replace-with-a-long-random-value
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-value
OIDC_SYNAPSE_SECRET=replace-with-a-long-random-value
ADMIN_API_OIDC_SECRET=replace-with-a-long-random-value

# Laisser désactivé ; en local, le bootstrap exige aussi ORYMA_ENVIRONMENT=development.
ORYMA_ENABLE_LOCAL_BOOTSTRAP=false

# Jeton d’un compte Synapse dédié, administrateur du homeserver et réservé à l’API.
# À configurer après la création du compte ; ne jamais committer le jeton.
SYNAPSE_ADMIN_ACCESS_TOKEN=

# Compte Matrix non administrateur réservé à la création des salles.
# Créer ce compte via l'inscription partagée Synapse puis protéger son jeton comme un secret.
SYNAPSE_ROOM_SERVICE_MATRIX_ID=@oryma-room-service:oryma.local
SYNAPSE_ROOM_SERVICE_ACCESS_TOKEN=

# Active les durées courtes de rétention pendant la démonstration.
DEMO_RETENTION=true
