# Adresse unique utilisée par le PC hôte, le second PC et le téléphone.
# À fixer avant le premier démarrage : elle devient le nom de serveur Matrix.
ORYMA_HOST=oryma.local

# Valeurs de démonstration uniquement. Ne jamais utiliser ces valeurs hors prototype.
POSTGRES_PASSWORD=change-me-postgres
SYNAPSE_DB_PASSWORD=change-me-synapse
KEYCLOAK_DB_PASSWORD=change-me-keycloak
ADMINAPI_DB_PASSWORD=change-me-adminapi
SYNAPSE_REGISTRATION_SECRET=change-me-registration
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
OIDC_SYNAPSE_SECRET=change-me-oidc

# Active les durées courtes de rétention pendant la démonstration.
DEMO_RETENTION=true
