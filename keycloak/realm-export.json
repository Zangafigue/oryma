{
  "realm": "oryma",
  "enabled": true,
  "displayName": "Oryma",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "defaultRoles": ["agent"],
  "roles": {
    "realm": [
      {"name": "agent", "description": "Agent enrôlé Oryma"},
      {"name": "admin", "description": "Administrateur Oryma"}
    ]
  },
  "requiredCredentials": ["password", "otp"],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "synapse",
      "name": "Synapse Oryma",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME_AFTER_BOOTSTRAP",
      "redirectUris": ["https://oryma.local/_synapse/client/oidc/callback"],
      "webOrigins": ["https://oryma.local"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ]
}
