{
  admin off
  auto_https disable_redirects
}

https://{env.ORYMA_HOST} {
  tls internal

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }

  @keycloak_cookie_check path /auth/realms/*/protocol/openid-connect/3p-cookies/*
  header @keycloak_cookie_check -X-Frame-Options

  @admin_api path /api/*
  reverse_proxy @admin_api admin-api:8080

  @matrix path /_matrix/* /_synapse/*
  reverse_proxy @matrix synapse:8008

  @keycloak path /auth/*
  reverse_proxy @keycloak keycloak:8080

  # Keycloak utilise ces iframes same-origin pour vérifier ses cookies et sa session.
  # La politique DENY globale empêcherait ces contrôles de se charger dans Chrome.
  @keycloak_session_iframes path /auth/realms/*/protocol/openid-connect/3p-cookies/* /auth/realms/*/protocol/openid-connect/login-status-iframe.html
  header @keycloak_session_iframes -X-Frame-Options

  reverse_proxy element:80
}

http://{env.ORYMA_HOST} {
  redir https://{env.ORYMA_HOST}{uri} permanent
}
